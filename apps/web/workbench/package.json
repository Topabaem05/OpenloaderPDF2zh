{
  "name": "openpdf2zh-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "build": "vite build && node scripts/build-worker.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "build:sites": "vite build && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "build:web": "vite build",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "prebuild:web": "node scripts/prepare-pdf-assets.mjs",
    "prebuild:sites": "node scripts/prepare-pdf-assets.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "vite": "7.3.5"
  }
}
